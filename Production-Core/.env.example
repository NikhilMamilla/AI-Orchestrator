# Backend settings: copy to Production-Core/backend/.env and fill in. Never commit .env.
# Frontend settings live in frontend/.env.example (copy to frontend/.env.local).
# Every service below has a free tier; the project runs at zero cost.

ENV=development                         # "production" disables AUTH_DISABLED and API docs
AUTH_DISABLED=false                     # dev-only shortcut; refuses to start with ENV=production
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAILS=you@example.com            # comma separated; once verified, these emails open the admin console
ADMIN_MIN_GROUP=5                       # admin views hide any learner group smaller than this (production only)

# --- Supabase (https://supabase.com, free) ---
# Settings > API: Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Settings > API > JWT Settings. Only needed for legacy HS256 projects; leave empty if your project
# uses the newer asymmetric signing keys (verified through the JWKS endpoint automatically).
# Sign-in is Firebase Auth (authentication only; all data stays in Supabase). The API accepts Firebase ID tokens
# from this project. Leave empty to accept Supabase Auth tokens instead.
FIREBASE_PROJECT_ID=
SUPABASE_JWT_SECRET=
# Settings > Database > Connection string > "Session pooler" (IPv4 compatible). Leave empty to use
# a local SQLite file instead (dev / offline).
DATABASE_URL=

# --- LLM (all free tiers). Providers are tried in LLM_PROVIDERS order with automatic failover ---
LLM_PROVIDERS=mistral,gemini,groq
MISTRAL_API_KEY=                         # https://console.mistral.ai (free "Experiment" tier)
GEMINI_API_KEY=                          # https://aistudio.google.com/apikey (free tier)
GROQ_API_KEYS=                           # https://console.groq.com (free tier); comma-separate several to rotate

# --- RAG ---
RAG_NEURAL=true                         # bge-small embeddings + MiniLM cross-encoder (local, free)
RAG_RATE_LIMIT_PER_MIN=20

# --- Optional ---
REDIS_URL=redis://localhost:6379/0
JUDGE0_API_KEY=
JUDGE0_API_URL=https://ce.judge0.com        # free public instance (rate-limited); JUDGE0_API_KEY only for RapidAPI
